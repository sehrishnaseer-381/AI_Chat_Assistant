
APP_NAME=AI Chat Assistant API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

GROQ_API_KEY=
# Groq model used for image-containing chat requests.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Model selection is per request: auto routing or a chat composer override.
# Legacy GROQ_MODEL values no longer select a single model.
GROQ_MAX_COMPLETION_TOKENS=4096
GROQ_DEFAULT_TEMPERATURE=0.7
# Optional global override (0.0-2.0); leave blank for automatic selection.
GROQ_TEMPERATURE_OVERRIDE=
DATABASE_URL=


GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback